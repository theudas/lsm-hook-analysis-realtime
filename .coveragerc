# 覆盖率统计配置：默认统计分支覆盖，只看服务代码本身。
# 用法见 README「运行测试」一节：
#   python3 -m coverage run -m unittest discover -s tests
#   python3 -m coverage report
#   python3 -m coverage html

[run]
branch = True
source = lha_realtime

[report]
show_missing = True
precision = 1
exclude_also =
    if TYPE_CHECKING:

[html]
directory = reports/coverage/html
title = LSM Hook Realtime Analysis 覆盖率
